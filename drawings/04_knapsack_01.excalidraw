   "link": null,
   "locked": false,
   "text": "Worked cell dp[3][7]: item 3 (w=4,v=5), j=7\n  skip: dp[2][7] = 5\n  take: 5 + dp[2][7-4] = 5 + dp[2][3] = 5+4 = 9\n  max(5, 9) = 9   <- the 4 and 5 come from the row ABOVE",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "originalText": "Worked cell dp[3][7]: item 3 (w=4,v=5), j=7\n  skip: dp[2][7] = 5\n  take: 5 + dp[2][7-4] = 5 + dp[2][3] = 5+4 = 9\n  max(5, 9) = 9   <- the 4 and 5 come from the row ABOVE",
   "lineHeight": 1.25
  },

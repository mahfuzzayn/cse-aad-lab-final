   "seed": 1996557994,
   "version": 1,
   "versionNonce": 1685037533,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "dp[i][j] = best value using first i items with capacity j.\nRule: dp[i][j] = max(dp[i-1][j],  v_i + dp[i-1][j-w_i]).\nFill row by row; answer = bottom-right cell.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "originalText": "dp[i][j] = best value using first i items with capacity j.\nRule: dp[i][j] = max(dp[i-1][j],  v_i + dp[i-1][j-w_i]).\nFill row by row; answer = bottom-right cell.",
   "lineHeight": 1.25
  },

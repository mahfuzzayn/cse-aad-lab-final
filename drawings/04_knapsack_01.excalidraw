  {
   "id": "wI5Pm5wXAm58",
   "type": "text",
   "x": 80,
   "y": 110,
   "width": 510.40000000000003,
   "height": 64.80000000000001,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,

   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "m[i][j] = cheapest cost of chain Ai..Aj. Fill by CHAIN LENGTH (2,3,...,n).\nm[i][j] = min_k m[i][k] + m[k+1][j] + p[i-1]*p[k]*p[j], s[i][j] remembers the best k.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",

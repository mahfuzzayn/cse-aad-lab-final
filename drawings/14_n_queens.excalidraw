   "seed": 749416283,
   "version": 1,
   "versionNonce": 904830562,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "Solution 1:  (0,1) (1,3) (2,0) (3,2)",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "originalText": "Solution 1:  (0,1) (1,3) (2,0) (3,2)",
   "lineHeight": 1.25
  },

   "link": null,
   "locked": false,
   "text": "Merge the two SMALLEST frequencies, n-1 times.\nLeft edge = 0, right edge = 1. Codes are read root -> leaf.\nRarest symbols end deepest (longest codes).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "originalText": "Merge the two SMALLEST frequencies, n-1 times.\nLeft edge = 0, right edge = 1. Codes are read root -> leaf.\nRarest symbols end deepest (longest codes).",
   "lineHeight": 1.25
  },

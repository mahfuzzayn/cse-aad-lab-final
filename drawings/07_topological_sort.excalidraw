   "roundness": null,
   "seed": 1719695831,
   "version": 1,
   "versionNonce": 950762777,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "Edges: 6->3, 6->1, 5->1, 4->3, 2->3, 1->2 (u before v).\nA vertex becomes 'ready' only when ALL its incoming edges are satisfied.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "originalText": "Edges: 6->3, 6->1, 5->1, 4->3, 2->3, 1->2 (u before v).\nA vertex becomes 'ready' only when ALL its incoming edges are satisfied.",
   "lineHeight": 1.25
  },

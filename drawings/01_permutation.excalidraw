   "versionNonce": 1147147369,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "Each tree level = one slot.\nBranch label = which unused item was placed.\nLeaves = complete permutations (n! = 6).\nUsed[] marks taken items; undo on return = backtracking.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "originalText": "Each tree level = one slot.\nBranch label = which unused item was placed.\nLeaves = complete permutations (n! = 6).\nUsed[] marks taken items; undo on return = backtracking.",
   "lineHeight": 1.25
  },

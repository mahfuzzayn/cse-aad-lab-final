   "link": null,
   "locked": false,
   "text": "13 \u2014 Bellman-Ford from 1 (handles negative edges): 1:0 2:5 3:7 4:1 5:8",
   "fontSize": 36,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "originalText": "13 \u2014 Bellman-Ford from 1 (handles negative edges): 1:0 2:5 3:7 4:1 5:8",
   "lineHeight": 1.25
  },
  {
   "id": "NaJ9EgdFLb9w",
   "type": "text",
   "x": 80,
   "y": 100,
   "width": 457.6,
   "height": 64.80000000000001,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1214837591,
   "version": 1,
   "versionNonce": 2073422174,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "No greedy lock: just relax EVERY edge, n-1 rounds.\nEach round extends the guarantee by one more edge.\nOne extra pass that still improves = negative cycle.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "originalText": "No greedy lock: just relax EVERY edge, n-1 rounds.\nEach round extends the guarantee by one more edge.\nOne extra pass that still improves = negative cycle.",
   "lineHeight": 1.25
  },

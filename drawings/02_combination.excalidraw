  {
   "id": "f0rVa2uqwaus",
   "type": "text",
   "x": 80,
   "y": 110,
   "width": 633.6,
   "height": 64.80000000000001,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1875921402,
   "version": 1,
   "versionNonce": 2044173278,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "Rule: the next pick must have a LARGER index than the last pick.\nThat single rule makes duplicate orderings impossible.\nGreen = size r=2 reached (print). Red = dead end (nothing left to pick).",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "originalText": "Rule: the next pick must have a LARGER index than the last pick.\nThat single rule makes duplicate orderings impossible.\nGreen = size r=2 reached (print). Red = dead end (nothing left to pick).",
   "lineHeight": 1.25
  },

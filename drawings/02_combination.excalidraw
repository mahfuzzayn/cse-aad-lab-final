  {
   "id": "GfLy0U5vei03",
   "type": "text",
   "x": 80,
   "y": 520,
   "width": 440.00000000000006,
   "height": 64.80000000000001,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 666992991,
   "version": 1,
   "versionNonce": 798698207,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "All 6 combinations printed in lexicographic order:\n1 2,  1 3,  1 4,  2 3,  2 4,  3 4\nCount formula: C(n,r) = n! / (r!(n-r)!)",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "originalText": "All 6 combinations printed in lexicographic order:\n1 2,  1 3,  1 4,  2 3,  2 4,  3 4\nCount formula: C(n,r) = n! / (r!(n-r)!)",
   "lineHeight": 1.25
  },
  {
   "id": "Va5qPfYegdFl",
   "type": "text",
   "x": 317.76,
   "y": 539.2,
   "width": 684.48,
   "height": 41.6,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1426684148,
   "version": 1,
   "versionNonce": 1258708849,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "Why no 'taken[]' array is needed: the start index only moves forward,\nso an earlier index can never be picked twice.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "originalText": "Why no 'taken[]' array is needed: the start index only moves forward,\nso an earlier index can never be picked twice.",
   "lineHeight": 1.25
  }

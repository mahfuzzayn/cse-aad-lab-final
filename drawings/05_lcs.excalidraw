   "locked": false,
   "text": "05 \u2014 LCS Table: s = ABCBDAB, t = BDCABA",
   "fontSize": 36,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "originalText": "05 \u2014 LCS Table: s = ABCBDAB, t = BDCABA",
   "lineHeight": 1.25
  },
  {
   "id": "aqmbd5KEviEQ",
   "type": "text",
   "x": 80,
   "y": 110,
   "width": 748.0000000000001,
   "height": 64.80000000000001,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1776177009,
   "version": 1,
   "versionNonce": 712717014,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "Match (s[i-1]==t[j-1]): take diagonal + 1\nMismatch: max(up, left)\nYellow = answer cell (4). Green cells = the backtrack path that reads BCBA backwards.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "originalText": "Match (s[i-1]==t[j-1]): take diagonal + 1\nMismatch: max(up, left)\nYellow = answer cell (4). Green cells = the backtrack path that reads BCBA backwards.",
   "lineHeight": 1.25
  },

   "updated": 1748000000000,
   "link": null,
   "locked": false,
   "text": "Backtrack from bottom-right: match -> go diagonal (collect letter); else step toward bigger neighbour.\nCollected backwards: A, C, B, B  ->  reversed: BCBA",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "originalText": "Backtrack from bottom-right: match -> go diagonal (collect letter); else step toward bigger neighbour.\nCollected backwards: A, C, B, B  ->  reversed: BCBA",
   "lineHeight": 1.25
  },
